{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Bone-Haff/bedrock/schemas/rollout-ledger.schema.json",
  "title": "Bedrock consumer-surface rollout ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "release_tag", "source_commit", "surfaces", "rollback", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected_action", "expected_identity", "status", "evidence", "owner"],
        "properties": {
          "id": {"enum": ["claude-ai", "claude-code", "codex"]},
          "expected_action": {"type": "string", "minLength": 1},
          "expected_identity": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "verified", "failed", "waived"]},
          "evidence": {"type": ["string", "null"]},
          "owner": {"type": "string", "minLength": 1},
          "waiver": {"type": ["string", "null"]}
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggered", "last_accepted_tag", "evidence"],
      "properties": {
        "triggered": {"type": "boolean"},
        "last_accepted_tag": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["pending", "complete", "failed", "rolled_back"]}
  }
}
